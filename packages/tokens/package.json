{
  "name": "@secrets/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Secrets design tokens: four themes (dark, black, light, system), accents, type, spacing, motion. TS + CSS variables.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tokens.css"
  ],
  "scripts": {
    "gen:css": "tsx scripts/build-css.ts",
    "build": "tsx scripts/build-css.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && tsx scripts/build-css.ts --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2"
  }
}
