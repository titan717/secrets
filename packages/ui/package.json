{
  "name": "@secrets/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Secrets shared UI kit (React web). Props/types and pure helpers are platform-neutral for React Native reuse.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shared": "./src/shared/index.ts",
    "./styles.css": "./src/styles.css",
    "./assets/*": "./src/assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@secrets/tokens": "workspace:^",
    "lucide-react": "^1.80.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5",
    "jsdom": "^25",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "~5.6",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2"
  }
}
