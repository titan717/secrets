{
  "name": "@secrets/vodozemac-wasm",
  "version": "0.5.0",
  "private": true,
  "description": "vodozemac (Olm + Megolm) wasm bindings for web/Node. Glue vendored from @kinsh/vodozemac-wasm@0.4.2; built in our CI.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "node": { "types": "./pkg-node/secrets_vodozemac_wasm.d.ts", "default": "./pkg-node/secrets_vodozemac_wasm.js" },
      "browser": { "types": "./pkg-web/secrets_vodozemac_wasm.d.ts", "default": "./pkg-web/secrets_vodozemac_wasm.js" },
      "default": { "types": "./pkg-web/secrets_vodozemac_wasm.d.ts", "default": "./pkg-web/secrets_vodozemac_wasm.js" }
    }
  },
  "files": ["pkg-web", "pkg-node", "LICENSE", "NOTICE"],
  "scripts": {
    "build:wasm": "tools/build.sh",
    "verify:wasm": "tools/build.sh && diff -u pkg.sha256 pkg.sha256.actual",
    "test:wasm": "node scripts/smoke.mjs && node scripts/verify-test-vectors.mjs"
  }
}
