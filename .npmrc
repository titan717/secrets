auto-install-peers=true
strict-peer-dependencies=false
# Supply chain (security review T-0001, C4):
# Dependency lifecycle scripts (preinstall/install/postinstall) are OFF unless the package is
# listed in package.json "pnpm.onlyBuiltDependencies". Adding an entry requires SECURITY-CRITIC review.
# Exact versions on `pnpm add`; CI uses `pnpm install --frozen-lockfile`.
save-exact=true
# Re-verify tarball integrity from the store against the lockfile.
verify-store-integrity=true
# Never let a dependency's `engines` silently pick another toolchain.
engine-strict=true
