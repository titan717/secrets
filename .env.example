# ── core ────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Public origin of the web app (used in email links).
APP_ORIGIN=http://localhost:5173

# ── security ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_TTL=7776000
# Salt for hashed IPs in the audit log.
IP_HASH_PEPPER=change-me-too
# Comma-separated allowlist; omit for same-origin only.
# CORS_ORIGIN=https://secrets.example

# ── data ────────────────────────────────────────────────────────────────
# Production: PostgreSQL. Unset = embedded PGlite (local development).
# DATABASE_URL=postgres://user:pass@host:5432/secrets
# PGLITE_DIR=./data/pglite
# REDIS_URL=redis://localhost:6379

# ── email ───────────────────────────────────────────────────────────────
# console (development, logs envelopes only) | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Secrets <noreply@example.com>"
# RESEND_API_KEY=re_...

# ── feature flags (1/0) ─────────────────────────────────────────────────
FEATURE_CALLS=1
FEATURE_AI=1
FEATURE_DOCKS=1
FEATURE_ATTACHMENTS=1
FEATURE_EMAIL_VERIFICATION=0
FEATURE_EXPERIMENTAL=0

# ── AI service (apps/ai) ────────────────────────────────────────────────
# Provider keys are bring-your-own-key from the browser; none are stored here.
AI_PORT=8790

# ── calls service (apps/calls) ──────────────────────────────────────────
CALLS_PORT=8791
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Membership checks are mandatory; the calls service fails closed without this.
SECRETS_API_URL=http://localhost:8080
