# ai.secrets — copy to .env for local dev. Provider / GitHub / Secrets keys are NEVER configured here:
# they come per request from the browser in headers (x-provider-key, x-github-token, x-secrets-token).
PORT=8790
HOST=0.0.0.0
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
# Default Secrets API base URL used by Secrets tools when the request body has no secrets_api_url
SECRETS_API_URL=http://localhost:8080
# Optional: shown to OpenRouter as the app identity
OPENROUTER_APP_URL=https://github.com/titan717/ai.secrets
OPENROUTER_APP_TITLE=Secrets
LOG_LEVEL=info
# Abort a provider stream that sends no data for this long (ms)
PROVIDER_STALL_TIMEOUT_MS=120000
