# voice.secretsapi
PORT=8791
HOST=0.0.0.0
CORS_ORIGIN=*
# LiveKit Cloud or self-hosted server (client-facing WebSocket URL)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same secret as the Secrets API (HS256 session JWTs). If unset, anonymous access is allowed (DEV ONLY).
JWT_SECRET=
# Optional: when set, room/token requests for conv_<id> verify membership via GET /v1/conversations/:id
SECRETS_API_URL=
# Seconds an empty room stays open before anyone joins / after last participant leaves
ROOM_EMPTY_TIMEOUT=300
ROOM_DEPARTURE_TIMEOUT=30
TOKEN_TTL=2h
LOG_LEVEL=info
